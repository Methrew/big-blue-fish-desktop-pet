<!-- Modified by Methrew on 2026-11-15 for the Taiwan Traditional Chinese edition of Bai-Cute/big-blue-fish-desktop-pet 1.1.3, which also takes in acer1204's taiwan-edition fork (Apache-2.0). -->
<Project>
  <PropertyGroup>
    <CompanionInputMode Condition="'$(CompanionInputMode)' == ''">Ocr</CompanionInputMode>
    <Version>1.1.3-tw.3</Version>
    <!-- Keep the self-contained runtime; avoid CET startup failures on older Windows patches. -->
    <CetCompat>false</CetCompat>
    <CompanionEdition Condition="'$(CompanionEdition)' == ''">Standard</CompanionEdition>
    <DefineConstants Condition="'$(CompanionEdition)' == 'Safe'">$(DefineConstants);COMPANION_SAFE</DefineConstants>
    <AssemblyVersion>$([System.Text.RegularExpressions.Regex]::Replace('$(Version)', '-.*$', '')).0</AssemblyVersion>
    <FileVersion>$(AssemblyVersion)</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationVersion>$(AssemblyVersion)</ApplicationVersion>
  </PropertyGroup>
</Project>
