<!-- Modified by Methrew on 2026-11-15 for the Taiwan Traditional Chinese edition of Bai-Cute/big-blue-fish-desktop-pet 1.1.3, which also takes in acer1204's taiwan-edition fork (Apache-2.0). -->
<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../deployment/SharedItems.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <StartupObject>BigBlueFish.InstallerVerification.Checks</StartupObject>
  </PropertyGroup>
  <PropertyGroup Condition="'$(CompanionInputMode)' == 'Ocr'">
    <DefineConstants>$(DefineConstants);COMPANION_OCR</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../installer/Program.cs" Link="Installer.cs" />
    <Compile Include="../../../installer/InstallationLifecycle.cs" Link="InstallationLifecycle.cs" />
    <Compile Include="../../../installer/UpdateTransaction.cs" Link="UpdateTransaction.cs" />
    <Compile Include="../../../uninstaller/UninstallApplication.cs" Link="UninstallApplication.cs" />
    <Compile Include="../../BigBlueFish.Windows/Companion/CompanionEdition.cs" Link="CompanionEdition.cs" />
    <EmbeddedResource Include="../../../Version.props" Link="Version.props" />
  </ItemGroup>
</Project>
