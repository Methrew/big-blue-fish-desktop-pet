<!-- Fork-original file of the Taiwan Traditional Chinese edition by Methrew (2026-11-15); not part of upstream Bai-Cute/big-blue-fish-desktop-pet. -->
<Project Sdk="Microsoft.NET.Sdk">
  <!-- Mac-only checks of the Taiwan edition identity: release versions, the read-only import from the original's data folder and the login item. -->
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><RuntimeIdentifier>osx-arm64</RuntimeIdentifier><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><DefineConstants>$(DefineConstants);COMPANION_MAC</DefineConstants></PropertyGroup>
  <ItemGroup>
    <Compile Include="../../BigBlueFish.Windows/Companion/CompanionEdition.cs" Link="Shared/CompanionEdition.cs" />
    <Compile Include="../../../deployment/ReleaseVersion.cs" Link="Shared/ReleaseVersion.cs" />
    <Compile Include="../../BigBlueFish.Mac/MacDataImport.cs" Link="Mac/MacDataImport.cs" />
    <Compile Include="../../BigBlueFish.Mac/MacLoginItem.cs" Link="Mac/MacLoginItem.cs" />
    <EmbeddedResource Include="../../../Version.props" LogicalName="Version.props" />
  </ItemGroup>
</Project>
