<Project Sdk="Microsoft.NET.Sdk">
  <!-- macOS only: the real native readings behind the reminders and get_context (BigBlueFish.Mac/MacSystem.cs). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../BigBlueFish.Mac/MacSystem.cs" Link="Mac/MacSystem.cs" />
    <Compile Include="../../BigBlueFish.Windows/Companion/CompanionEdition.cs" Link="Shared/CompanionEdition.cs" />
  </ItemGroup>
</Project>
