<!-- Fork-original file of the Taiwan Traditional Chinese edition by Methrew (2026-11-15); not part of upstream Bai-Cute/big-blue-fish-desktop-pet. -->
<Project Sdk="Microsoft.NET.Sdk">
  <!-- The remote model path of the macOS edition against a fake OpenAI-compatible server (HttpListener):
       dotnet run with the project code/tests/RemoteModelVerification and -r osx-arm64 on a Mac (win-x64 is the default).
       The arguments "live <url> [api-key]" test a real server instead, such as runtime/llama-server started with an API key.
       CompanionBrain is compiled as macOS has it (COMPANION_OCR, COMPANION_MAC); the window capture, OCR and window
       identity are stand-ins (Stubs.cs) that record what was asked of them. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NuGetLockFilePath>packages.$(RuntimeIdentifier).lock.json</NuGetLockFilePath>
    <DefineConstants>$(DefineConstants);COMPANION_OCR;COMPANION_MAC</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../BigBlueFish.Windows/Companion/CompanionBrain.cs" Link="Shared/CompanionBrain.cs" />
    <Compile Include="../../BigBlueFish.Windows/Companion/CompanionCloud.cs" Link="Shared/CompanionCloud.cs" />
    <Compile Include="../../BigBlueFish.Windows/Companion/CompanionDialogue.cs" Link="Shared/CompanionDialogue.cs" />
    <Compile Include="../../BigBlueFish.Windows/Companion/CompanionWeather.cs" Link="Shared/CompanionWeather.cs" />
    <Compile Include="../../BigBlueFish.Windows/Companion/CompanionNews.cs" Link="Shared/CompanionNews.cs" />
    <Compile Include="../../BigBlueFish.Windows/Companion/CompanionInferenceDevices.cs" Link="Shared/CompanionInferenceDevices.cs" />
    <Compile Include="../../BigBlueFish.Windows/Companion/CompanionRegions.cs" Link="Shared/CompanionRegions.cs" />
    <Compile Include="../../BigBlueFish.Windows/Companion/CompanionOcrLayout.cs" Link="Shared/CompanionOcrLayout.cs" />
    <Compile Include="../../../deployment/ModelStore.cs" Link="Shared/ModelStore.cs" />
    <Compile Include="../../BigBlueFish.Linux/LinuxProcesses.cs" Link="Linux/LinuxProcesses.cs" />
    <Compile Include="../../BigBlueFish.Linux/LinuxRemoteScreen.cs" Link="Linux/LinuxRemoteScreen.cs" />
    <!-- The weather request names the place from the region data, as the app embeds it. -->
    <EmbeddedResource Include="../../BigBlueFish.Windows/assets/regions/china-regions.json;../../BigBlueFish.Windows/assets/regions/taiwan-regions.json;../../BigBlueFish.Windows/assets/regions/us-regions.json;../../BigBlueFish.Windows/assets/regions/world-regions.json;../../BigBlueFish.Windows/assets/regions/world-countries.json;../../BigBlueFish.Windows/assets/regions/region-display-names.json"
      LogicalName="BigBlueFish.Windows.assets.regions.%(Filename)%(Extension)" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="Anthropic" Version="13.8.0" />
    <ProjectReference Include="../../BigBlueFish.Diagnostics/BigBlueFish.Diagnostics.csproj" />
  </ItemGroup>
</Project>
