<Project Sdk="Microsoft.NET.Sdk">
  <!-- Regions, display names, weather and the macOS secret storage, runnable on macOS as well as Windows:
       dotnet run with the project code/tests/WeatherRegionVerification and -r osx-arm64 on a Mac (win-x64 is the default);
       the argument "live" adds real Open-Meteo requests.
       CompanionPreferences is compiled as macOS has it (COMPANION_MAC, keychain through MacKeychain, here with a stand-in
       for /usr/bin/security); COMPANION_SAFE only leaves the Agent project out of it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NuGetLockFilePath>packages.$(RuntimeIdentifier).lock.json</NuGetLockFilePath>
    <DefineConstants>$(DefineConstants);COMPANION_MAC;COMPANION_SAFE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../BigBlueFish.Windows/Companion/CompanionRegions.cs" Link="Shared/CompanionRegions.cs" />
    <Compile Include="../../BigBlueFish.Windows/Companion/CompanionWeather.cs" Link="Shared/CompanionWeather.cs" />
    <Compile Include="../../BigBlueFish.Windows/Companion/CompanionPreferences.cs" Link="Shared/CompanionPreferences.cs" />
    <Compile Include="../../BigBlueFish.Windows/Companion/CompanionEdition.cs" Link="Shared/CompanionEdition.cs" />
    <Compile Include="../../BigBlueFish.Mac/MacKeychain.cs" Link="Mac/MacKeychain.cs" />
    <Compile Include="../RunnerVerification/WeatherCacheVerification.cs" Link="Shared/WeatherCacheVerification.cs" />
    <EmbeddedResource Include="../../BigBlueFish.Windows/assets/regions/china-regions.json;../../BigBlueFish.Windows/assets/regions/taiwan-regions.json;../../BigBlueFish.Windows/assets/regions/us-regions.json;../../BigBlueFish.Windows/assets/regions/world-regions.json;../../BigBlueFish.Windows/assets/regions/world-countries.json;../../BigBlueFish.Windows/assets/regions/region-display-names.json"
      LogicalName="BigBlueFish.Windows.assets.regions.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../BigBlueFish.Windows/assets/opencc/STCharacters.txt;../../BigBlueFish.Windows/assets/opencc/TWVariants.txt" LogicalName="%(Filename)%(Extension)" />
    <ProjectReference Include="../../BigBlueFish.Diagnostics/BigBlueFish.Diagnostics.csproj" />
    <ProjectReference Include="../../BigBlueFish.Control/BigBlueFish.Control.csproj" />
  </ItemGroup>
</Project>
